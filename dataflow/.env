# Google Cloud Project Configuration
GCP_PROJECT=your-gcp-project-id
REGION=us-central1

# Pub/Sub Configuration
PUBSUB_SUBSCRIPTION=projects/your-gcp-project-id/subscriptions/your-subscription-id

# Cloud Storage Paths (GCS)
BRONZE_PATH=gs://your-bucket-name/bronze/
SILVER_PATH=gs://your-bucket-name/silver/
TEMP_LOCATION=gs://your-bucket-name/temp/
STAGING_LOCATION=gs://your-bucket-name/staging/

# BigQuery Configuration
BIGQUERY_TABLE=your-gcp-project-id:your_dataset_name.air_quality_gold
